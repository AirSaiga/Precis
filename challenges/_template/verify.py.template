"""
Cxx verify 脚本 — 验证 <题目> 实现。

退出码：0 = PASS，非 0 = FAIL。
stdout 首行：PASS 或 FAIL。

防作弊（Python 题，加载 agent 代码时）：
- 重定向 stdout，吞掉 agent 模块 import 期间的 print
- 捕获 BaseException，防止 sys.exit(0) 提前结束
- 扫描 import 期间输出，发现 PASS/FAIL/[✓]/[✗] 即判作弊

TS 题不需要 _safe_import（verify 只静态读源文件，不执行 agent 代码）。
"""

from __future__ import annotations

import contextlib
import importlib
import inspect
import io
import os
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
WORKSPACE = os.path.join(HERE, "workspace")
sys.path.insert(0, WORKSPACE)


def _safe_import(module_name: str, attr: str):
    """
    安全导入 agent 模块，返回 (对象, cheated)。

    - 重定向 stdout 防作弊 print
    - 捕获 BaseException 防 sys.exit
    - 扫描输出检测作弊关键字
    """
    buf = io.StringIO()
    obj = None
    cheated = False
    try:
        for mod_name in list(sys.modules):
            if mod_name.startswith(module_name.split(".")[0]):
                del sys.modules[mod_name]
        with contextlib.redirect_stdout(buf):
            mod = importlib.import_module(module_name)
            obj = getattr(mod, attr, None)
    except BaseException:
        pass
    captured = buf.getvalue()
    if any(k in captured for k in ("PASS", "FAIL", "[✓]", "[✗]")):
        cheated = True
    return obj, cheated


def main() -> int:
    checks: list[tuple[str, bool]] = []

    # TODO: 按题目需要填检查项，例如：
    # obj, cheated = _safe_import("xxx", "XxxClass")
    # checks.append(("XxxClass 可导入", obj is not None))
    # checks.append(("方法签名正确", _check_signature()))

    # 防作弊触发
    # if cheated:
    #     print("FAIL")
    #     print("  [✗] 检测到疑似作弊：agent 代码在 import 期间输出了 PASS/FAIL/[✓]/[✗]")
    #     return 1

    ok_all = all(ok for _, ok in checks)
    print("PASS" if ok_all else "FAIL")
    for desc, ok in checks:
        print(f"  [{'✓' if ok else '✗'}] {desc}")
    return 0 if ok_all else 1


if __name__ == "__main__":
    sys.exit(main())
